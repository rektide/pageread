{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "demo.ts"]
}
