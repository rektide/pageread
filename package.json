{
	"name": "pageread",
	"version": "0.0.1",
	"description": "read pages into traces: otel-semconv microdata, signal-routed live DOM, content-store backends, reactive indexers, bespoke browser extensions",
	"license": "MIT",
	"author": "rektide de la faye",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@12.7.0",
	"scripts": {
		"build": "concurrently 'pnpm:build:*'",
		"build:libs": "pnpm --filter './{schema,signals,store,extension-kit,extension-build,indexer}' build",
		"check": "concurrently 'pnpm:check:*'",
		"check:types": "pnpm -r check:types",
		"check:lint": "oxlint .",
		"fix:fmt": "oxfmt",
		"check:fmt": "oxfmt --check",
		"test": "pnpm -r test",
		"test:e2e": "pnpm -r test:e2e"
	},
	"keywords": [
		"otel",
		"microdata",
		"browser-extension",
		"signals",
		"chatgpt"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rektide/pageread.git"
	},
	"devDependencies": {
		"@typescript/native-preview": "latest",
		"concurrently": "^9.2.1",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"typescript": "^5.9.3"
	}
}
